{
  "name": "@noti0ns/agent-deck",
  "version": "1.0.0",
  "private": true,
  "description": "Tablet-first observability deck for AI coding agents (OpenCode, Claude Code, Codex, agy)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/doctor"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "build:hooks": "node tools/hook-shim/build.mjs",
    "test": "vitest run",
    "test:e2e": "node tools/test-e2e.mjs test",
    "test:hooks": "go -C tools/hook-shim test ./...",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "agent-deck": "node --import tsx apps/collector/src/cli.ts",
    "release:bundle": "node tools/prepare-release.mjs",
    "release:smoke": "node tools/smoke-release.mjs",
    "release:npm": "node tools/prepare-npm.mjs",
    "release:npm:smoke": "node tools/smoke-npm.mjs",
    "verify:clean": "node tools/verify-clean.mjs"
  },
  "bin": {
    "agent-deck": "./apps/collector/dist/cli.js"
  },
  "engines": {
    "node": "^22.22.0 || ^24.0.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tar": "^7.5.22",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
