{
  "name": "agent-deck",
  "version": "1.0.0",
  "private": true,
  "description": "Tablet-first observability deck for AI coding agents (OpenCode, Claude Code, Codex, agy)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/doctor"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "agent-deck": "node --import tsx apps/collector/src/cli.ts"
  },
  "bin": {
    "agent-deck": "./apps/collector/dist/cli.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
